FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    mpv \
    ffmpeg \
    nodejs \
    alsa-utils \
    procps \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip flask ytmusicapi yt-dlp

WORKDIR /app
COPY ytm.py /app/ytm.py

EXPOSE 8001

ENV YTM_PORT=8001 \
    YTM_DIR=/app/YTMusic

CMD ["python3", "ytm.py"]